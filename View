package human.resource.management.system;

import javax.swing.*;
import java.awt.*;
import java.awt.event.*;
import java.sql.ResultSet;
import net.proteanit.sql.DbUtils;

public class View extends JFrame implements ActionListener {

    Choice choiceEMP;
    JTable table;
    JButton searchbtn, print, update, back, add;

    View() {

        setLayout(null);
        setSize(900, 500);
        setTitle("View Employee");
        getContentPane().setBackground(new Color(255, 131, 122));
        setDefaultCloseOperation(JFrame.DISPOSE_ON_CLOSE);
        setLocationRelativeTo(null);

        JLabel search = new JLabel("Search by employee id");
        search.setFont(new Font("Raleway", Font.BOLD, 20));
        search.setBounds(30, 20, 300, 25);
        add(search);

        choiceEMP = new Choice();
        choiceEMP.setBounds(350, 20, 150, 25);
        add(choiceEMP);

        table = new JTable();

        try {
            conn c = new conn();

            ResultSet rs1 = c.statement.executeQuery("SELECT empid FROM employee");
            while (rs1.next()) {
                choiceEMP.add(rs1.getString("empid"));
            }

            ResultSet rs2 = c.statement.executeQuery("SELECT * FROM employee");
            table.setModel(DbUtils.resultSetToTableModel(rs2));

        } catch (Exception e) {
            e.printStackTrace();
        }

        JScrollPane sp = new JScrollPane(table);
        sp.setBounds(0, 80, 880, 380);
        add(sp);

        searchbtn = new JButton("Search");
        searchbtn.setBounds(50, 45, 100, 25);
        searchbtn.addActionListener(this);
        add(searchbtn);

        print = new JButton("Print");
        print.setBounds(150, 45, 100, 25);
        print.addActionListener(this);
        add(print);

        update = new JButton("Update");
        update.setBounds(250, 45, 100, 25);
        update.addActionListener(this);
        add(update);

        back = new JButton("Back");
        back.setBounds(350, 45, 100, 25);
        back.addActionListener(this);
        add(back);

        add = new JButton("Add");
        add.setBounds(450, 45, 100, 25);
        add.addActionListener(this);
        add(add);

        setVisible(true);
    }

    public void actionPerformed(ActionEvent e) {

        if (e.getSource() == searchbtn) {

            String query = "SELECT * FROM employee WHERE empid = '" +
                    choiceEMP.getSelectedItem() + "'";

            try {
                conn c = new conn();
                ResultSet rs = c.statement.executeQuery(query);
                table.setModel(DbUtils.resultSetToTableModel(rs));
            } catch (Exception ex) {
                ex.printStackTrace();
            }

        } else if (e.getSource() == print) {

            try {
                table.print();
            } catch (Exception ex) {
                ex.printStackTrace();
            }

        } else if (e.getSource() == update) {

            setVisible(false);
            new Update(choiceEMP.getSelectedItem());

        } else if (e.getSource() == add) {
            

        } else if (e.getSource() == back) {
            setVisible(false);
            new Main_Class().setVisible(true);
        }
    }

    public static void main(String[] args) {
        new View();
    }
}
